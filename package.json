{
  "name": "fantasy-drafter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-gameweek FPL squad and transfer optimiser. Static site, in-browser MILP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch:data": "node scripts/fetch-fpl.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs && node scripts/prepare-data.mjs",
    "sample:data": "node scripts/make-sample.mjs",
    "test": "tsx scripts/check-model.ts"
  },
  "dependencies": {
    "highs": "^1.15.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}